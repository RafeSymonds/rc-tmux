# Per-machine settings for rctt. Lives at ~/.config/rc-tmux/local.env and is
# not shared between machines (sessions.conf can be).

# launchd and cron start with a bare PATH: make sure tmux, claude and brew are found.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# Chrome for sessions whose config line says nothing: on | off | unset
# (unset = don't pass --chrome/--no-chrome; claude then starts with Chrome off).
RC_CHROME_DEFAULT=unset

# After the daily `rct update`: always | changed (only when a new version installed) | never
RC_RESTART_AFTER_UPDATE=always

# The daily job also runs `brew update && brew upgrade && brew cleanup` once every
# this many days (0 = never). Hold a formula back with `brew pin <name>`.
RC_BREW_UPGRADE_DAYS=7

# Browser `rct chrome up` opens on macOS (e.g. "Microsoft Edge", "Brave Browser").
# RC_CHROME_APP="Google Chrome"

# tmux session name, if "rc" clashes with something.
# RC_TMUX=rc
